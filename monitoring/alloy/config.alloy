loki.source.file "durimoa_backend" {
  targets = [
    {
      __path__    = "/var/log/durimoa/*.log",
      job         = "durimoa-backend",
      service     = "durimoa-backend",
      environment = sys.env("DURIMOA_ENVIRONMENT"),
    },
  ]
  forward_to = [loki.process.durimoa_backend.receiver]

  file_match {
    enabled     = true
    sync_period = "5s"
  }
}

loki.process "durimoa_backend" {
  stage.regex {
    expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}) \\[[^]]+\\] (?P<level>[A-Z]+)"
  }

  stage.timestamp {
    source = "timestamp"
    format = "2006-01-02 15:04:05.000"
    location = "Asia/Seoul"
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
