<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.domain.mypage.mapper.MypageMapper">

    <resultMap id="linkedAccountResultMap"
               type="com.project.domain.mypage.dto.LinkedAccountDTO">

        <id column="account_id" property="id"/>
        <result column="company" property="company"/>
        <result column="account_name" property="accountName"/>
        <result column="number" property="number"/>
    </resultMap>

    <resultMap id="linkedCardResultMap"
               type="com.project.domain.mypage.dto.LinkedCardDTO">

        <id column="card_id" property="id"/>
        <result column="company" property="company"/>
        <result column="card_name" property="cardName"/>
        <result column="image" property="image"/>
    </resultMap>

    <select id="selectLinkedAccounts"
            parameterType="long"
            resultMap="linkedAccountResultMap">

        SELECT id            AS account_id,
               company       AS company,
               account_name  AS account_name,
               number        AS number
        FROM account
        WHERE user_id = #{userId}
        ORDER BY id ASC

    </select>

    <select id="selectLinkedCards"
            parameterType="long"
            resultMap="linkedCardResultMap">

        SELECT c.id        AS card_id,
               c.company   AS company,
               c.card_name AS card_name,
               cp.image    AS image
        FROM card c
                 LEFT JOIN card_product cp
                           ON cp.id = c.card_product_id
        WHERE c.user_id = #{userId}
        ORDER BY c.id ASC

    </select>

</mapper>
