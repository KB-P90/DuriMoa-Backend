# Database Configuration
jdbc.driverClassName=net.sf.log4jdbc.sql.jdbcapi.DriverSpy
jdbc.url=jdbc:log4jdbc:mysql://localhost:3306/durimoadb?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
jdbc.username=
jdbc.password=

# JWT Configuration
# 운영 환경에서는 32바이트 이상의 무작위 값을 Base64로 인코딩하여 사용하세요.
jwt.secret=
jwt.access-token-expiration=3600000
