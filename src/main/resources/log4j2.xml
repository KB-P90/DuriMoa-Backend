<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO" packages="com.project.common.logging">
    <Properties>
        <Property name="logDir">${env:DURIMOA_LOG_DIR:-logs}</Property>
        <Property name="logPattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level [requestId=%X{requestId}] %logger{36} - %msg%n</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${logPattern}"/>
        </Console>
        <RollingFile name="ApplicationFile"
                     fileName="${logDir}/application.log"
                     filePattern="${logDir}/archive/application-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${logPattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>
        <Rewrite name="Sanitized">
            <SensitiveDataRewritePolicy/>
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ApplicationFile"/>
        </Rewrite>
    </Appenders>
    <Loggers>
        <Logger name="com.project" level="DEBUG" additivity="false">
            <AppenderRef ref="Sanitized"/>
        </Logger>
        <Logger name="jdbc.sqlonly" level="OFF" additivity="false">
            <AppenderRef ref="Sanitized"/>
        </Logger>
        <Logger name="jdbc.sqltiming" level="WARN" additivity="false">
            <AppenderRef ref="Sanitized"/>
        </Logger>
        <Logger name="jdbc.resultsettable" level="OFF" additivity="false">
            <AppenderRef ref="Sanitized"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="Sanitized"/>
        </Root>
    </Loggers>
</Configuration>
